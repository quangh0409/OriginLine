# Copy to .env.local for local development. Never commit real secrets here;
# all NEXT_PUBLIC_* values are exposed to the browser bundle by design.

# Backend dev origin (CLAUDE.md: backend dev runs at localhost:8080).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Set to "enabled" to run the app entirely against MSW mocks instead of a
# real backend (see `npm run dev:mock`). Ignored in production builds.
NEXT_PUBLIC_API_MOCKING=enabled

# Keycloak adapter placeholder (F0 scope only — no login flow wired yet).
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8081
NEXT_PUBLIC_KEYCLOAK_REALM=giapha
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=giapha-frontend

# Set to "true" to exercise the generated service worker (Web Push handlers)
# during `next dev`; normally the SW is disabled in dev to avoid stale-cache
# confusion during hot reload.
NEXT_PUBLIC_ENABLE_PWA_DEV=false
