{
  "name": "giapha-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Cong thong tin gia pha dong ho - frontend PWA (Next.js App Router)",
  "scripts": {
    "dev": "next dev",
    "dev:mock": "cross-env NEXT_PUBLIC_API_MOCKING=enabled next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "msw:init": "msw init public/ --save",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:real": "playwright test --config=playwright.real.config.ts",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report .playwright-mcp/report"
  },
  "dependencies": {
    "@ant-design/cssinjs": "^1.21.1",
    "@ant-design/icons": "^5.5.2",
    "@ant-design/nextjs-registry": "^1.3.0",
    "@ducanh2912/next-pwa": "^10.2.9",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@xyflow/react": "^12.11.5",
    "antd": "^5.29.3",
    "d3-hierarchy": "^3.1.2",
    "dagre": "^0.8.5",
    "graphql": "^16.9.0",
    "graphql-request": "^7.4.0",
    "keycloak-js": "^25.0.6",
    "next": "15.3.9",
    "next-intl": "^3.26.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "^7.87.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/dagre": "^0.7.54",
    "@types/node": "20.19.43",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^2.1.9",
    "@vitest/ui": "^2.1.9",
    "autoprefixer": "10.5.4",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.3.9",
    "jsdom": "^25.0.1",
    "msw": "^2.15.0",
    "postcss": "8.5.26",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^2.1.9"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
