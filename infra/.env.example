# ===========================================================================
# Gia Phả Dòng Họ — biến môi trường cho môi trường DEV
#
#   cd infra
#   cp .env.example .env
#   docker compose up -d --wait
#
# File .env KHÔNG được commit (.gitignore ở thư mục gốc đã chặn).
# Toàn bộ giá trị dưới đây là mật khẩu DEV rác, cố ý để yếu cho dễ nhớ.
# Môi trường staging/production phải sinh giá trị mới và giữ trong vault/
# secret manager — không bao giờ đặt trong repo.
# ===========================================================================

# --- Chung -----------------------------------------------------------------
TZ=Asia/Ho_Chi_Minh

# --- PostgreSQL 16 + Apache AGE (datastore duy nhất) -----------------------
POSTGRES_DB=giapha
POSTGRES_USER=giapha
POSTGRES_PASSWORD=giapha
POSTGRES_PORT=5432

# --- Redis (cache cây + session) -------------------------------------------
REDIS_PORT=6379

# --- RabbitMQ (nhắc giỗ bất đồng bộ, retry + DLQ) --------------------------
RABBITMQ_USER=giapha
RABBITMQ_PASSWORD=giapha
RABBITMQ_VHOST=/
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672

# --- MinIO (ảnh chân dung, văn bia, mộ phần, gia phả scan) -----------------
# MINIO_ROOT_PASSWORD phải >= 8 ký tự, nếu không MinIO từ chối khởi động.
MINIO_ROOT_USER=giapha
MINIO_ROOT_PASSWORD=giapha123
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# Danh sách bucket tạo sẵn, cách nhau bằng dấu cách. Tất cả đều private.
MINIO_BUCKETS=giapha-portraits giapha-stele giapha-graves giapha-documents

# --- Keycloak (OAuth2/OIDC) ------------------------------------------------
# Cổng 8081 vì 8080 dành cho backend Spring Boot.
KEYCLOAK_PORT=8081
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=giapha
KEYCLOAK_BACKEND_CLIENT_ID=giapha-backend
# Secret DEV, đã nằm sẵn trong infra/keycloak/realm-giapha.json.
# Đổi giá trị ở CẢ HAI chỗ nếu muốn dùng secret khác.
KEYCLOAK_BACKEND_CLIENT_SECRET=dev-only-backend-secret-change-me
KEYCLOAK_FRONTEND_CLIENT_ID=giapha-frontend

# ===========================================================================
# Tham chiếu cho backend (backend/src/main/resources/application-*.yml).
# Đặt ở đây để một người mới thấy được toàn bộ đường dây kết nối trong 1 file;
# backend do workstream khác cấu hình, không tự đọc file .env này.
# ===========================================================================
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/giapha
# SPRING_DATASOURCE_USERNAME=giapha
# SPRING_DATASOURCE_PASSWORD=giapha
# BẮT BUỘC — nạp AGE trên MỌI connection của pool, xem README "Bẫy Apache AGE":
# SPRING_DATASOURCE_HIKARI_CONNECTION_INIT_SQL=LOAD 'age'; SET search_path = ag_catalog, "$user", public;
# SPRING_DATA_REDIS_HOST=localhost
# SPRING_DATA_REDIS_PORT=6379
# SPRING_RABBITMQ_HOST=localhost
# SPRING_RABBITMQ_PORT=5672
# SPRING_RABBITMQ_USERNAME=giapha
# SPRING_RABBITMQ_PASSWORD=giapha
# SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=http://localhost:8081/realms/giapha
# MINIO_ENDPOINT=http://localhost:9000
# MINIO_ACCESS_KEY=giapha
# MINIO_SECRET_KEY=giapha123

# --- Web Push / VAPID (Giai đoạn 1, W5) ------------------------------------
# Sinh cặp khoá bằng thư viện web-push rồi điền vào .env — KHÔNG commit khoá
# riêng. Khoá public cũng cần cho frontend (NEXT_PUBLIC_VAPID_PUBLIC_KEY).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@giapha.local
